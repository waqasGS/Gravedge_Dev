MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1160461525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 19c789670a80b704eba4dfebed94a111, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  header: COMMENT
  comment: "To climb objects make sure to add the tag ClimbUp and just copy the vClimb
    component from the ThirdPerson_Climb prefab to your new character. (also make
    sure to copy the Climb animation state to your own Animator Controller)\n\n*
    About Missing Animations\r\n\r\n- This addon doens't come with animations but
    don't worry, we prepare a Mixamo's Package already setup and ready to use, you
    can download and extract the folder \"VbotClimb\" inside the Animations folder.
    \r\n\nDOWNLOAD: https://drive.google.com/open?id=12gQGdCw7gwxdAqQSn4PLdkldTEpM4qTV\r\r\n\r\nps*
    Don't forget to also extract the .meta files \nps2* If you can't see the .meta
    files inside the folder, make sure to enable the hidden files of your windows"
  inEdit: 0
